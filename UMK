AS = arm-none-eabi-as
CC = arm-none-eabi-gcc
LD = arm-none-eabi-ld
OBJCOPY = arm-none-eabi-objcopy
SIZE = arm-none-eabi-size

ARCH = arm/cortex-m4

ASFLAGS = -mcpu=cortex-m4 -mthumb -mfloat-abi=hard -mfpu=fpv4-sp-d16
CFLAGS = -mcpu=cortex-m4 -mthumb -mfloat-abi=hard -mfpu=fpv4-sp-d16 -O3 -Wall -Wextra -ffreestanding -nostdlib -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables -ffunction-sections -fdata-sections -Iinclude
LDFLAGS = -mcpu=cortex-m4 -mthumb -T arch/$(ARCH)/linker.ld -nostdlib -Wl,--gc-sections

arch/$(ARCH)/%.o: arch/$(ARCH)/%.S
    $(AS) $(ASFLAGS) -o $@ $<
eoc

arch/$(ARCH)/%.o: arch/$(ARCH)/%.c
    $(CC) $(CFLAGS) -c -o $@ $<
eoc

kernel/%.o: kernel/%.c
    $(CC) $(CFLAGS) -c -o $@ $<
eoc

hal/%.o: hal/%.c
    $(CC) $(CFLAGS) -c -o $@ $<
eoc

sdk/%.o: sdk/%.c
    $(CC) $(CFLAGS) -c -o $@ $<
eoc

machine/%.o: machine/%.c
    $(CC) $(CFLAGS) -c -o $@ $<
eoc

utms9.elf: $(OBJS)
    $(CC) $(CFLAGS) $(LDFLAGS) -o $@ $^
    $(SIZE) $@
eoc

utms9.bin: utms9.elf
    $(OBJCOPY) -O binary $< $@
eoc

build:
    ASRCS = $(wildcard arch/$(ARCH)/*.S)
    CSRCS = $(wildcard arch/$(ARCH)/*.c kernel/*.c hal/*.c sdk/*.c machine/renode_test/*.c)
    OBJS = $(ASRCS:.S=.o) $(CSRCS:.c=.o)
    call utms9.elf
    call utms9.bin
    echo "=== UTMS9_a+cm BUILD COMPLETE (renode_test) ==="
eoc

build-stm32:
    ASRCS = $(wildcard arch/$(ARCH)/*.S)
    CSRCS = $(wildcard arch/$(ARCH)/*.c kernel/*.c hal/*.c sdk/*.c machine/stm32f407/*.c)
    OBJS = $(ASRCS:.S=.o) $(CSRCS:.c=.o)
    call utms9.elf
    call utms9.bin
    echo "=== UTMS9_a+cm BUILD COMPLETE (stm32f407) ==="
eoc

build-renode:
    ASRCS = $(wildcard arch/$(ARCH)/*.S)
    CSRCS = $(wildcard arch/$(ARCH)/*.c kernel/*.c hal/*.c sdk/*.c machine/renode_test/*.c)
    OBJS = $(ASRCS:.S=.o) $(CSRCS:.c=.o)
    call utms9.elf
    call utms9.bin
    echo "=== UTMS9_a+cm BUILD COMPLETE (renode_test) ==="
eoc

build-custom:
    ASRCS = $(wildcard arch/$(ARCH)/*.S)
    CSRCS = $(wildcard arch/$(ARCH)/*.c kernel/*.c hal/*.c sdk/*.c machine/$(MACHINE)/*.c)
    OBJS = $(ASRCS:.S=.o) $(CSRCS:.c=.o)
    if $(CUSTOM_CFLAGS)
        CFLAGS = $(CFLAGS) $(CUSTOM_CFLAGS)
    endif
    call utms9.elf
    call utms9.bin
    echo "=== UTMS9_a+cm BUILD COMPLETE ($(MACHINE)) ==="
eoc

clean:
    find . -name "*.o" -type f -delete
    rm -f utms9.elf utms9.bin
eoc
